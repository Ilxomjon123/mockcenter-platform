{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MockCenter",
  "version": "0.1.0",
  "identifier": "com.mockcenter.ielts",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "MockCenter IELTS",
        "fullscreen": true,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true,
        "closable": false,
        "minimizable": false,
        "maximizable": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: https://admin.mockcenter.uz https://*.mockcenter.uz; img-src 'self' data: blob: https: http:; media-src 'self' data: blob: https: http:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https: http:; font-src 'self' data:; frame-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "MockCenter IELTS Exam Platform",
    "longDescription": "A comprehensive IELTS exam practice platform with listening, reading, and writing sections."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzNzNDN0QzQzQyQjMyRkMKUldUOE1pdkUwOGR6ZzdOU1hmQkZkYUhuS2RTTXpuTjc2RzlvYlAvYU1SUVVaRXFVYjJENU9kNTEK",
      "endpoints": [
        "https://github.com/Ilxomjon123/mockcenter-platform/releases/latest/download/latest.json"
      ]
    }
  }
}
